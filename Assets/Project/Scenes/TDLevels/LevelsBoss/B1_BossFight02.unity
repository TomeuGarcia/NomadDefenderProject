  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4d11f268a16d40789fb933997829db7f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _victoryDialogue:
    _startDelay: 4
    _betweenLinesDelay: 1.5
    _finishDelay: 4
    _textLines:
    - textType: 1
      text: Well... you beat me this time.
      clearTime: 0
    - textType: 1
      text: "Heh. Don\u2019t get cocky."
      clearTime: 0
    - textType: 1
      text: "Next time, I\u2019ll\u2014"
      clearTime: 0
    - textType: 1
      text: Oh.
      clearTime: 0
    - textType: 1
      text: Wait.
      clearTime: 0
    - textType: 1
      text: There is no next time.
      clearTime: 0
    - textType: 1
      text: The devs ran out of funding.
      clearTime: 0
    - textType: 1
      text: No publisher. No future.
      clearTime: 0
    - textType: 1
      text: Tough times. People gotta eat.
      clearTime: 0
    - textType: 1
      text: Guess this is it.
      clearTime: 0
    - textType: 1
      text: Hope you understand.
      clearTime: 0
    - textType: 1
      text: Thanks for playing.
      clearTime: 0
    - textType: 1
      text: "Let\u2019s roll the credits, I guess."
      clearTime: 0
