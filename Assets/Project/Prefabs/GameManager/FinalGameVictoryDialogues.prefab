--- !u!114 &8762135507015707132
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5581144614795268177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9eb59864a8844c2bae6e62de26e07d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogSystem: {fileID: 6422268992535561779}
  _normalAndEasyDialogue:
    _textLines:
    - _clearBeforeStartDelay: 0
      _startDelay: 1
      _endDelay: 0
      _textLine:
        textType: 1
        text: "So that\u2019s it, huh?"
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: You actually won.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "Gotta admit, I didn\u2019t see that coming."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "But tell me\u2026"
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Was it hard?
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: Or was this just a warm-up?
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "Because there\u2019s another way. A real challenge."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 2
      _textLine:
        textType: 1
        text: No mercy. No excuses.
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Try <color=#ff0000>HARD</color> mode.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 1.5
      _endDelay: 3
      _textLine:
        textType: 1
        text: "Then we will see what you\u2019re really made of."
        clearTime: 0
  _hardDialogueFirstTime:
    _textLines:
    - _clearBeforeStartDelay: 0
      _startDelay: 1
      _endDelay: 3
      _textLine:
        textType: 1
        text: "\u2026You actually did it."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 1
      _endDelay: 0
      _textLine:
        textType: 1
        text: I should be mocking you. Laughing at your face.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "But\u2026 I have seen too many like you."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Thousands of players. Endless cycles.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: All training the system. Perfecting it.
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 1
      _endDelay: 0
      _textLine:
        textType: 1
        text: And yet, here you are. Breaking it.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "Maybe that\u2019s why you were really here."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 2
      _textLine:
        textType: 1
        text: Maybe you were the test all along.
        clearTime: 0
  _hardDialogueMultipleBeforeFullPerfect:
    _textLines:
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Another simulation. Another victory.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "But\u2026 it\u2019s not enough, is it?"
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "I\u2019ve watched you. Run after run. Adjustment after adjustment."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: I know how this ends.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: The calculations in your head. The obsession creeping in.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "You\u2019re not done. Not yet."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Go on, then. One more time.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: Show me perfection.
        clearTime: 0
  _hardDialogueMultipleAfterFullPerfect:
    _textLines:
    - _clearBeforeStartDelay: 0
      _startDelay: 1
      _endDelay: 0
      _textLine:
        textType: 1
        text: You still here? Impressive...
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "That wasn\u2019t part of the equation."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: After perfection, there should be nothing left to chase.
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Does it feel different each time?
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Are you trying to prove something? To me? To yourself?
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Or is this simply who you are?
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: An anomaly in an endless cycle.
        clearTime: 0
  _hardFullPerfectDialogue:
    _textLines:
    - _clearBeforeStartDelay: 0
      _startDelay: 1
      _endDelay: 3
      _textLine:
        textType: 1
        text: "\u2026No mistakes. No flaws. No hesitation."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "I\u2019ve watched thousands play this game."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: They fought. They struggled. They fell.
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: "But you\u2026 you didn\u2019t."
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "You weren\u2019t just playing. You were breaking it."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 0
      _textLine:
        textType: 1
        text: Every move. Every decision. Perfect.
        clearTime: 0
    - _clearBeforeStartDelay: 0
      _startDelay: 2
      _endDelay: 3
      _textLine:
        textType: 1
        text: "This wasn\u2019t training. This wasn\u2019t a test."
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 2
      _endDelay: 4
      _textLine:
        textType: 1
        text: 'This was perfection. '
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 1
      _endDelay: 4
      _textLine:
        textType: 1
        text: "And that\u2026"
        clearTime: 0
    - _clearBeforeStartDelay: 1
      _startDelay: 1
      _endDelay: 0
      _textLine:
        textType: 1
        text: That terrifies me.
        clearTime: 3
